NVIDIA_API_KEY=nvapi-tu_clave_aqui
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

POSTGRES_DB=parachute
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute
POSTGRES_PORT=5432
DATABASE_URL=postgresql://parachute:parachute@localhost:5432/parachute

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
MIN_SIMILARITY=0.35

# Archivo local compartido por los tres programas para almacenar citas.
APPOINTMENTS_DB=appointments.sqlite3

# Hoja 7: servidores locales MCP (Streamable HTTP) y A2A.
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=10
A2A_HOST=127.0.0.1
A2A_PORT=8000
A2A_SERVER_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# Fase 6: "real" conserva todas las integraciones anteriores; "demo" sustituye
# únicamente PostgreSQL/RAG, Open-Meteo y la SQLite de citas por fixtures locales.
PARACHUTE_MODE=real
DEMO_APPOINTMENTS_DB=.demo/appointments.demo.sqlite3
DEMO_CORPUS_PATH=Corpus_FAQs_Parachute_SA_2026.txt
